# Local-only Docker Compose defaults. Copy to .env.local if you want to customize them.
LOCAL_DATABASE_NAME=research
LOCAL_DATABASE_USER=research
LOCAL_DATABASE_PASSWORD=research-local-only
LOCAL_POSTGRES_PORT=5433
LOCAL_INGESTION_PORT=8081
LOCAL_WEB_PORT=8080

# Optional. Only needed to exercise GitHub/Gemini-backed web features locally.
GITHUB_TOKEN=
GEMINI_API_KEY=
