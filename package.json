{
  "name": "@github-statistics/web",
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "pnpm run build:packages && pnpm exec vite",
    "start": "pnpm run dev",
    "build": "pnpm run build:web",
    "build:packages": "pnpm --filter @github-statistics/ingestion-contracts build && pnpm --filter @github-statistics/research-database build",
    "build:web": "pnpm run build:packages && pnpm exec vite build",
    "build:ingestion": "pnpm run build:packages && pnpm --filter @github-statistics/ingestion-api build",
    "build:all": "pnpm run build:web && pnpm --filter @github-statistics/ingestion-api build",
    "watch": "pnpm exec vite build --watch",
    "graphql:codegen": "pnpm exec graphql-codegen --config codegen.ts",
    "research:setup": "Rscript research/framework-popularity/scripts/install_dependencies.R",
    "research:refresh": "Rscript research/framework-popularity/refresh_data.R --source=all",
    "research:refresh:npm": "Rscript research/framework-popularity/refresh_data.R --source=npm",
    "research:collect:npm-ingestion": "cd research/framework-popularity && Rscript jobs/collect_npm_ingestion.R",
    "research:publish:npm-ingestion": "cd research/framework-popularity && Rscript jobs/publish_npm_ingestion.R",
    "research:refresh:trends": "Rscript research/framework-popularity/refresh_data.R --source=google",
    "research:refresh:stars": "Rscript research/framework-popularity/refresh_data.R --source=github",
    "research:forecasts": "Rscript research/framework-popularity/refresh_data.R --source=none",
    "research:validate": "Rscript research/framework-popularity/refresh_data.R --validate-only",
    "local:up": "docker compose --env-file .env.local -f compose.yaml up --build --detach",
    "local:dev": "node tools/local-dev.mjs",
    "local:db:up": "docker compose --env-file .env.local -f compose.yaml up --detach postgres",
    "local:down": "docker compose --env-file .env.local -f compose.yaml down",
    "local:reset": "docker compose --env-file .env.local -f compose.yaml down --volumes",
    "local:status": "docker compose --env-file .env.local -f compose.yaml ps",
    "local:logs": "docker compose --env-file .env.local -f compose.yaml logs --follow",
    "local:smoke": "node tools/local-ingestion-smoke.mjs",
    "local:pipeline:npm": "node tools/run-local-npm-pipeline.mjs",
    "local:compare:npm": "pnpm run build:packages && node tools/compare-npm-data.mjs",
    "local:compare:npm:strict": "pnpm run build:packages && node tools/compare-npm-data.mjs --strict",
    "test": "pnpm run build:packages && pnpm exec vitest run && pnpm exec vitest run --config vitest.node.config.ts",
    "preview": "node dist/analog/server/index.mjs"
  },
  "private": true,
  "dependencies": {
    "@github-statistics/research-database": "workspace:*",
    "@analogjs/content": "^2.3.1",
    "@analogjs/router": "^2.3.1",
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@google/genai": "^1.29.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.1.4",
    "chart.js": "^4.4.9",
    "front-matter": "^4.0.2",
    "h3": "^1.13.0",
    "html2canvas": "^1.4.1",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "ng2-charts": "^7.0.0",
    "postcss": "^8.5.3",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.15.2",
    "@analogjs/platform": "^2.3.1",
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.2",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@types/node": "^25.5.0",
    "graphql": "^16.11.0",
    "jsdom": "^22.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.0"
  }
}
